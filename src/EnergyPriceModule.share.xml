<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
	<op:config name="%EP_NumChannelsDefault%" value="1" />
	<ManufacturerData>
		<Manufacturer>
			<ApplicationPrograms>
				<ApplicationProgram>
					<Static>
						<ParameterTypes>
							<ParameterType Id="%AID%_PT-EPNumChannels" Name="EPNumChannels">
								<TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="0" maxInclusive="%N%" />
							</ParameterType>
							<ParameterType Id="%AID%_PT-EPProviderType" Name="EPProviderType">
								<TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
								<Enumeration Text="Deaktiviert"    Value="0" Id="%ENID%" />
								<Enumeration Text="aWATTar"        Value="1" Id="%ENID%" />
								<Enumeration Text="Energy Charts"  Value="2" Id="%ENID%" />
							</TypeRestriction>
						</ParameterType>
						<ParameterType Id="%AID%_PT-EPCountry" Name="EPCountry">
							<TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
								<Enumeration Text="Deutschland" Value="0" Id="%ENID%" />
								<Enumeration Text="Österreich"  Value="1" Id="%ENID%" />
							</TypeRestriction>
						</ParameterType>
						<!-- Energy Charts Bidding Zone -->
						<ParameterType Id="%AID%_PT-EPEnergyChartsBZN" Name="EPEnergyChartsBZN">
							<TypeRestriction Base="Value" SizeInBit="8" UIHint="DropDown">
								<Enumeration Text="Deutschland/Luxemburg (DE-LU)" Value="0"  Id="%ENID%" />
								<Enumeration Text="Österreich (AT)"              Value="1"  Id="%ENID%" />
								<Enumeration Text="Schweiz (CH)"                 Value="2"  Id="%ENID%" />
								<Enumeration Text="Belgien (BE)"                 Value="3"  Id="%ENID%" />
								<Enumeration Text="Frankreich (FR)"              Value="4"  Id="%ENID%" />
								<Enumeration Text="Niederlande (NL)"             Value="5"  Id="%ENID%" />
								<Enumeration Text="Dänemark West (DK1)"          Value="6"  Id="%ENID%" />
								<Enumeration Text="Dänemark Ost (DK2)"           Value="7"  Id="%ENID%" />
								<Enumeration Text="Norwegen 1 (NO1)"             Value="8"  Id="%ENID%" />
								<Enumeration Text="Norwegen 2 (NO2)"             Value="9"  Id="%ENID%" />
								<Enumeration Text="Norwegen 3 (NO3)"             Value="10" Id="%ENID%" />
								<Enumeration Text="Norwegen 4 (NO4)"             Value="11" Id="%ENID%" />
								<Enumeration Text="Norwegen 5 (NO5)"             Value="12" Id="%ENID%" />
								<Enumeration Text="Schweden 1 (SE1)"             Value="13" Id="%ENID%" />
								<Enumeration Text="Schweden 2 (SE2)"             Value="14" Id="%ENID%" />
								<Enumeration Text="Schweden 3 (SE3)"             Value="15" Id="%ENID%" />
								<Enumeration Text="Schweden 4 (SE4)"             Value="16" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<ParameterType Id="%AID%_PT-EPRefreshInterval" Name="EPRefreshInterval">
								<TypeRestriction Base="Value" SizeInBit="8">
									<Enumeration Text="Keine"        Value="0" Id="%ENID%" />
									<Enumeration Text="30 Minuten"   Value="1" Id="%ENID%" />
									<Enumeration Text="Jede Stunde"  Value="2" Id="%ENID%" />
									<Enumeration Text="Täglich"      Value="3" Id="%ENID%" />
								</TypeRestriction>
							</ParameterType>
							<!-- Price threshold in ct/kWh * 10, range 0..500 → 0.0..50.0 ct/kWh -->
							<ParameterType Id="%AID%_PT-EPPriceLevel" Name="EPPriceLevel">
								<TypeNumber SizeInBit="16" Type="unsignedInt" minInclusive="0" maxInclusive="500" />
							</ParameterType>
							<!-- Cheapest window in hours 1..12 -->
							<ParameterType Id="%AID%_PT-EPWindowHours" Name="EPWindowHours">
								<TypeNumber SizeInBit="8" Type="unsignedInt" minInclusive="1" maxInclusive="12" />
							</ParameterType>
						</ParameterTypes>
						<Parameters>
							<!-- Number of channels -->
							<Union SizeInBit="8">
								<Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
								<Parameter Id="%AID%_UP-%TT%00000" Name="VisibleChannels" ParameterType="%AID%_PT-EPNumChannels" Offset="0" BitOffset="0" Text="Verfügbare Kanäle" Value="%EP_NumChannelsDefault%" SuffixText=" von %N%" />
							</Union>
						</Parameters>
						<ParameterRefs>
							<ParameterRef Id="%AID%_UP-%TT%00000_R-%TT%0000001" RefId="%AID%_UP-%TT%00000" />
						</ParameterRefs>
						<ComObjectTable>
							<!-- Refresh Energy Price Data -->
							<ComObject Id="%AID%_O-%TT%00001" Name="RefreshData" Text="Strompreis aktualisieren" Number="0" FunctionText="Strompreis: Eingang, Auslöser" ObjectSize="1 Bit" ReadFlag="Disabled" WriteFlag="Enabled" CommunicationFlag="Enabled" TransmitFlag="Disabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
						</ComObjectTable>
						<ComObjectRefs>
							<!-- Refresh Energy Price Data -->
							<ComObjectRef Id="%AID%_O-%TT%00001_R-%TT%0000101" RefId="%AID%_O-%TT%00001" Name="RefreshData" Priority="Low" ObjectSize="1 Bit" DatapointType="DPST-1-17" />
						</ComObjectRefs>
					</Static>
					<Dynamic>
							<Channel Name="MainChannel%TT%" Text="Strompreis" Number="%PREFIX%" Id="%AID%_CH-%TT%" Icon="meter-electric-outline">
							<ParameterBlock Id="%AID%_PB-nnn" Name="EPSettings" Text="Allgemein" Icon="cog-outline">
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Strompreis" UIHint="Headline" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
								<ParameterRefRef IndentLevel="1" RefId="%AID%_UP-%TT%00000_R-%TT%0000001" />
								<ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
								<!-- Refresh: nur sichtbar wenn mindestens 1 Kanal aktiviert -->
								<choose ParamRefId="%AID%_UP-%TT%00000_R-%TT%0000001">
									<when test="&gt;=1">
										<ComObjectRefRef RefId="%AID%_O-%TT%00001_R-%TT%0000101" />
									</when>
								</choose>
							</ParameterBlock>
							<op:include href="EnergyPriceModule.templ.xml" xpath="//Dynamic/ChannelIndependentBlock/*" type="template" prefix="EP" IsInner="true" />
							<!-- More page: shown when fewer channels are selected than max -->
							<choose ParamRefId="%AID%_UP-%TT%00000_R-%TT%0000001">
								<when test="&lt;%N%">
									<ParameterBlock Id="%AID%_PB-nnn" Name="EPAdditionalChannels" Text="(mehr)" Icon="dots-horizontal">
										<ParameterSeparator Id="%AID%_PS-nnn" Text="Kanalauswahl" UIHint="Headline" />
										<ParameterRefRef RefId="%AID%_UP-%TT%00000_R-%TT%0000001" />
									</ParameterBlock>
								</when>
							</choose>
						</Channel>
					</Dynamic>
				</ApplicationProgram>
			</ApplicationPrograms>
		</Manufacturer>
	</ManufacturerData>
</KNX>
