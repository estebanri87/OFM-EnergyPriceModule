<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_14/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer"
  xmlns="http://knx.org/xml/project/14" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <Parameters>
              <!-- Channel name -->
              <Parameter Id="%AID%_P-%TT%%CC%000" Name="Channel%C%Name" ParameterType="%AID%_PT-Text40Byte" Text="Beschreibung" Value="" />

              <!-- Provider type (Byte 0) - Haupttyp, steht in der Kanalauswahl-Tabelle -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%001" Name="CH%C%ProviderType" ParameterType="%AID%_PT-EPProviderType" Offset="0" BitOffset="0" Text="Strompreisanbieter" Value="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%008" Name="CH%C%Suspended"    ParameterType="%AID%_PT-Suspended"      Offset="0" BitOffset="4" Text="Suspendiert" Value="0" />
              </Union>

              <!-- TypeSelect: kein Union, keine Memory-Referenz -> nur in ETS gespeichert, nicht auf dem Geraet -->
              <Parameter Id="%AID%_P-%TT%%CC%997" Name="Ch%C%TypeSelect" ParameterType="%AID%_PT-EPProviderTypeSelect" Text="Strompreisanbieter" Value="1" />

              <!-- Anzeigename fuer den Kanal-Tab: Beschreibung, der bei "Suspendiert = Ja"
                   das Zeichen der Kanalauswahl vorangestellt wird. Nur in der ETS. -->
              <Parameter Id="%AID%_P-%TT%%CC%998" Name="Ch%C%NameDisplay" ParameterType="%AID%_PT-Text45Byte" Text="Beschreibung (Anzeige)" Value="" Access="Read" op:configTransfer="never" />

              <!-- Country (Byte 1) – nur bei aWATTar -->
              <Union SizeInBit="8" op:nowarn="true" >
                <Memory CodeSegment="%MID%" Offset="1" BitOffset="0"  />
                <Parameter Id="%AID%_UP-%TT%%CC%002" Name="CH%C%Country" ParameterType="%AID%_PT-EPCountry" Offset="0" BitOffset="0" Text="Land" Value="0" />
              </Union>

              <!-- Energy Charts Bidding Zone (Byte 1, selber Offset wie Country) -->
              <Union SizeInBit="8" op:nowarn="true">
                <Memory CodeSegment="%MID%" Offset="1" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%007" Name="CH%C%EnergyChartsBZN" ParameterType="%AID%_PT-EPEnergyChartsBZN" Offset="0" BitOffset="0" Text="Handelszone" Value="0" />
              </Union>

              <!-- Refresh interval (Byte 2) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="2" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%003" Name="CH%C%RefreshInterval" ParameterType="%AID%_PT-EPRefreshInterval" Offset="0" BitOffset="0" Text="Automatische Aktualisierung" Value="2" />
              </Union>

              <!-- Price level: cheap threshold ct/kWh * 10 (Bytes 3-4) -->
              <Union SizeInBit="16">
                <Memory CodeSegment="%MID%" Offset="3" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%004" Name="CH%C%PriceLevelCheap" ParameterType="%AID%_PT-EPPriceLevel" Offset="0" BitOffset="0" Text="Günstig bis" SuffixText=" × 0.1 ct/kWh" Value="150" />
              </Union>

              <!-- Price level: expensive threshold ct/kWh * 10 (Bytes 5-6) -->
              <Union SizeInBit="16">
                <Memory CodeSegment="%MID%" Offset="5" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%005" Name="CH%C%PriceLevelExpensive" ParameterType="%AID%_PT-EPPriceLevel" Offset="0" BitOffset="0" Text="Teuer ab" SuffixText=" × 0.1 ct/kWh" Value="300" />
              </Union>

              <!-- Cheapest consecutive window in hours (Byte 7) -->
              <Union SizeInBit="8">
                <Memory CodeSegment="%MID%" Offset="7" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%%CC%006" Name="CH%C%CheapestWindowHours" ParameterType="%AID%_PT-EPWindowHours" Offset="0" BitOffset="0" Text="Günstigste zusammenhängende Stunden" Value="1" />
              </Union>
            </Parameters>
            <ParameterRefs>
              <!-- Channel name -->
              <ParameterRef Id="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_P-%TT%%CC%000" />
              <!-- Provider type -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" RefId="%AID%_UP-%TT%%CC%001" />
              <!-- Country -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" RefId="%AID%_UP-%TT%%CC%002" />
              <!-- Refresh interval -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" RefId="%AID%_UP-%TT%%CC%003" />
              <!-- Cheap threshold -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" RefId="%AID%_UP-%TT%%CC%004" />
              <!-- Expensive threshold -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" RefId="%AID%_UP-%TT%%CC%005" />
              <!-- Cheapest window hours -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" RefId="%AID%_UP-%TT%%CC%006" />
              <!-- Energy Charts BZN -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%007_R-%TT%%CC%00701" RefId="%AID%_UP-%TT%%CC%007" />
              <!-- TypeSelect -->
              <ParameterRef Id="%AID%_P-%TT%%CC%997_R-%TT%%CC%99701" RefId="%AID%_P-%TT%%CC%997" />
              <!-- Suspendiert -->
              <ParameterRef Id="%AID%_UP-%TT%%CC%008_R-%TT%%CC%00801" RefId="%AID%_UP-%TT%%CC%008" />
              <!-- Anzeigename -->
              <ParameterRef Id="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" RefId="%AID%_P-%TT%%CC%998" />
            </ParameterRefs>
            <ParameterCalculations>
              <!-- Haelt Haupttyp (Kanalauswahl) und TypeSelect (Kanal-Tab) synchron -->
              <ParameterCalculation Id="%AID%_PC-%TT%%CC%001" Language="JavaScript" Name="SyncType%CC%" RLTransformationFunc="BASE_SyncChannelType" LRTransformationFunc="BASE_SyncChannelType">
                <LParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%997_R-%TT%%CC%99701" AliasName="TypeValue" />
                </LParameters>
                <RParameters>
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" AliasName="TypeValue" />
                </RParameters>
              </ParameterCalculation>

              <!-- Suspendierte Kanaele in der Baumansicht kennzeichnen -->
              <ParameterCalculation Id="%AID%_PC-%TT%%CC%002" Language="JavaScript" Name="MarkInactive%CC%"
                                    RLTransformationFunc="BASE_MarkInactiveChannel" RLTransformationParameters="{&quot;InactiveValue&quot;:1}"
                                    LRTransformationFunc="BASE_Nop">
                <LParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" AliasName="TextOutput" />
                </LParameters>
                <RParameters>
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" AliasName="TextInput" />
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%008_R-%TT%%CC%00801" AliasName="InactiveControl" />
                </RParameters>
              </ParameterCalculation>
            </ParameterCalculations>
            <ComObjectTable>
              <!-- Aktueller Strompreis (ct/kWh) -->
              <ComObject Id="%AID%_O-%TT%%CC%000" Number="%K0%" Name="CH%C%CurrentPrice" Text="" ObjectSize="2 Bytes" DatapointType="" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- Durchschnittspreis heute (ct/kWh) -->
              <ComObject Id="%AID%_O-%TT%%CC%001" Number="%K1%" Name="CH%C%AvgPriceToday" Text="" ObjectSize="2 Bytes" DatapointType="" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- Mindestpreis heute (ct/kWh) -->
              <ComObject Id="%AID%_O-%TT%%CC%002" Number="%K2%" Name="CH%C%MinPriceToday" Text="" ObjectSize="2 Bytes" DatapointType="" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- Höchstpreis heute (ct/kWh) -->
              <ComObject Id="%AID%_O-%TT%%CC%003" Number="%K3%" Name="CH%C%MaxPriceToday" Text="" ObjectSize="2 Bytes" DatapointType="" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- Preisniveau (0=günstig, 1=normal, 2=teuer) -->
              <ComObject Id="%AID%_O-%TT%%CC%004" Number="%K4%" Name="CH%C%PriceLevel" Text="" ObjectSize="1 Byte" DatapointType="DPST-5-10" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- Morgen-Preise verfügbar -->
              <ComObject Id="%AID%_O-%TT%%CC%005" Number="%K5%" Name="CH%C%TomorrowAvailable" Text="" ObjectSize="1 Bit" DatapointType="DPST-1-1" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
              <!-- Beginn des günstigsten Fensters (Uhrzeit) -->
              <ComObject Id="%AID%_O-%TT%%CC%006" Number="%K6%" Name="CH%C%CheapestWindowStart" Text="" ObjectSize="3 Bytes" DatapointType="DPST-10-1" FunctionText="" ReadFlag="Enabled" WriteFlag="Disabled" CommunicationFlag="Enabled" TransmitFlag="Enabled" UpdateFlag="Disabled" ReadOnInitFlag="Disabled" />
            </ComObjectTable>
            <ComObjectRefs>
              <!-- Aktueller Strompreis -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" RefId="%AID%_O-%TT%%CC%000" Name="CH%C%CurrentPrice" Text="{{0:Strom %C%}}: Aktueller Strompreis" FunctionText="Strom %C%: Ausgang, Preis, ct/kWh" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
              <!-- Durchschnittspreis heute -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%001_R-%TT%%CC%00101" RefId="%AID%_O-%TT%%CC%001" Name="CH%C%AvgPriceToday" Text="{{0:Strom %C%}}: Durchschnittspreis Heute" FunctionText="Strom %C%: Ausgang, Preis, ct/kWh" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
              <!-- Mindestpreis heute -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%002_R-%TT%%CC%00201" RefId="%AID%_O-%TT%%CC%002" Name="CH%C%MinPriceToday" Text="{{0:Strom %C%}}: Mindestpreis Heute" FunctionText="Strom %C%: Ausgang, Preis, ct/kWh" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
              <!-- Höchstpreis heute -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%003_R-%TT%%CC%00301" RefId="%AID%_O-%TT%%CC%003" Name="CH%C%MaxPriceToday" Text="{{0:Strom %C%}}: Höchstpreis Heute" FunctionText="Strom %C%: Ausgang, Preis, ct/kWh" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
              <!-- Preisniveau -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%004_R-%TT%%CC%00401" RefId="%AID%_O-%TT%%CC%004" Name="CH%C%PriceLevel" Text="{{0:Strom %C%}}: Preisniveau" FunctionText="Strom %C%: Ausgang, Niveau, 0=günstig, 1=normal, 2=teuer" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
              <!-- Morgen verfügbar -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%005_R-%TT%%CC%00501" RefId="%AID%_O-%TT%%CC%005" Name="CH%C%TomorrowAvailable" Text="{{0:Strom %C%}}: Morgen verfügbar" FunctionText="Strom %C%: Ausgang, Verfügbarkeit, Ja/Nein" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
              <!-- Günstigstes Fenster -->
              <ComObjectRef Id="%AID%_O-%TT%%CC%006_R-%TT%%CC%00601" RefId="%AID%_O-%TT%%CC%006" Name="CH%C%CheapestWindowStart" Text="{{0:Strom %C%}}: Günstigstes Preisfenster" FunctionText="Strom %C%: Ausgang, Uhrzeit" TextParameterRefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Priority="Low" />
            </ComObjectRefs>
          </Static>
          <Dynamic>
            <ChannelIndependentBlock>

              <!-- Eine Zeile der Kanalauswahl-Tabelle: je Kanal eine eigene Grid-Tabelle -->
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings">
                <ParameterBlock Id="%AID%_PB-nnn" Inline="true" Layout="Grid">
                  <Rows>
                    <Row Id="%AID%_PB-nnn_R-1" />
                  </Rows>
                  <Columns>
                    <Column Id="%AID%_PB-nnn_C-1" Width="10%" />
                    <Column Id="%AID%_PB-nnn_C-2" Width="35%" />
                    <Column Id="%AID%_PB-nnn_C-3" Width="55%" />
                  </Columns>
                  <ParameterSeparator Id="%AID%_PS-nnn" Cell="1,1" Text="Kanal %C%" />
                  <!-- Haupttyp: hier wird aktiviert und deaktiviert -->
                  <ParameterRefRef RefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101" Cell="1,2" HelpContext="EP-Stromanbieter" />
                  <!-- Beschreibung bleibt auch bei Deaktiviert sichtbar -->
                  <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" Cell="1,3" HelpContext="BASE-ChannelName" />
                </ParameterBlock>
              </ParameterBlock>

              <ParameterBlock Id="%AID%_PB-nnn" Name="Channel">
              <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                <when test="&gt;0">
                  <ParameterBlock Id="%AID%_PB-nnn" Name="f%CC%EP" Text="Kanal %C%: {{0: ...}}" TextParameterRefId="%AID%_P-%TT%%CC%998_R-%TT%%CC%99801" Icon="meter-electric-outline" ShowInComObjectTree="true" HelpContext="EP-Stromanbieter">
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Kanaldefinition" UIHint="Headline" />
                    <!-- Beschreibung -->
                    <ParameterRefRef RefId="%AID%_P-%TT%%CC%000_R-%TT%%CC%00001" HelpContext="BASE-ChannelName" />
                    <!-- Strompreisanbieter (ohne "Deaktiviert", synchron zur Kanalauswahl) -->
                    <ParameterRefRef RefId="%AID%_P-%TT%%CC%997_R-%TT%%CC%99701" HelpContext="EP-Stromanbieter" />
                    <!-- Suspendiert -->
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%008_R-%TT%%CC%00801" HelpContext="BASE-ChannelSuspended" />
                    <!-- Land - nur bei aWATTar -->
                    <choose ParamRefId="%AID%_UP-%TT%%CC%001_R-%TT%%CC%00101">
                      <when test="1">
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%002_R-%TT%%CC%00201" HelpContext="EP-Land" />
                      </when>
                      <when test="2">
                        <ParameterRefRef RefId="%AID%_UP-%TT%%CC%007_R-%TT%%CC%00701" HelpContext="EP-Handelszone" />
                      </when>
                    </choose>
                    <!-- Automatische Aktualisierung -->
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%003_R-%TT%%CC%00301" HelpContext="EP-Automatische-Aktualisierung" />
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                    <ParameterSeparator Id="%AID%_PS-nnn" Text="Preisgrenzen" UIHint="Headline" />
                    <!-- Günstig bis -->
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%004_R-%TT%%CC%00401" HelpContext="EP-Guenstig-bis" />
                    <!-- Teuer ab -->
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%005_R-%TT%%CC%00501" HelpContext="EP-Teuer-ab" />
                    <!-- Günstigstes Fenster -->
                    <ParameterRefRef RefId="%AID%_UP-%TT%%CC%006_R-%TT%%CC%00601" HelpContext="EP-Guenstigstes-Preisfenster" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%000_R-%TT%%CC%00001" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%001_R-%TT%%CC%00101" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%002_R-%TT%%CC%00201" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%003_R-%TT%%CC%00301" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%004_R-%TT%%CC%00401" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%005_R-%TT%%CC%00501" />
                    <ComObjectRefRef RefId="%AID%_O-%TT%%CC%006_R-%TT%%CC%00601" />
                  </ParameterBlock>
                </when>
              </choose>
              </ParameterBlock>

            </ChannelIndependentBlock>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
    </Manufacturer>
  </ManufacturerData>
</KNX>
